# Copy to .env.local — never commit real keys.
# Supabase: Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Modern publishable key (or legacy anon key)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key-placeholder
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-placeholder

# Modern secret key (server only, or legacy service_role key)
SUPABASE_SECRET_KEY=your-supabase-secret-key-placeholder
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-placeholder

# Canonical public URL (used for metadata, OG URLs, and resolving icon paths on production)
NEXT_PUBLIC_SITE_URL=https://www.unimondo.uk

# Storage bucket for /apply uploads (must match Supabase bucket, default: documents)
SUPABASE_STORAGE_BUCKET=documents

ADMIN_EMAILS=admin@example.com
# Super admin: full access + can manage other admins in Team & account (also set is_super_admin in DB for that user)
SUPER_ADMIN_EMAIL=admin@example.com
# One-time: create Auth user (never commit ADMIN_SEED_PASSWORD)
# ADMIN_SEED_PASSWORD='...' npm run seed:admin
